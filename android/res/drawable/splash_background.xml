<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1A140F"
                android:centerColor="#0B0E14"
                android:endColor="#07090E"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap android:src="@drawable/riderise_badge" android:gravity="center" />
    </item>
</layer-list>
