<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge these nodes into android/app/src/main/AndroidManifest.xml in the Gradle project.
  Do NOT add them to the SDK-free pipeline's manifest: there is no Firebase class there to
  instantiate, and the app would crash on startup.

  Permission note: POST_NOTIFICATIONS is already declared by the shipped manifest; the
  firebase-messaging library adds the receivers/service below automatically once the
  dependency is present, so in most setups you only need the meta-data block.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Default notification channel. Must match channel_id sent by the server:
             android.notification.channel_id = "riderise_default" in backend/phase2/core.js -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="riderise_default" />

        <!-- Notification icon shown on Android 5+. Use a white-on-transparent asset. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Accent colour for the small icon background. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/rr_accent" />

        <service
            android:name=".RideRiseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
