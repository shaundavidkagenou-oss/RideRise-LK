# RideRise LK — environment template
# Copy to `.env` (git-ignored). `npm start` and `npm run dev` load it automatically
# (node --env-file-if-exists=.env), so no extra flag is needed.
# Nothing here is required to open the app locally. Each unset block simply disables
# one integration — the app never pretends a service is connected.
# Full setup walkthrough: docs/EXTERNAL_CONFIG.md

# ---------------------------------------------------------------- core / auth
# Port for the web app + API (default 3000).
PORT=3000
# Set to `production` before deploying. Production refuses the demo admin credential.
NODE_ENV=development
# Signing secret for session tokens (32+ chars). Generate: openssl rand -hex 32
# Required in production (the server refuses to start without it).
# If unset in development, a random key is generated per boot: sessions end on restart.
JWT_SECRET=
# REMOVED: Google Sign-In / OAuth. Riders sign in with Firebase email + password only.
# The server no longer reads GOOGLE_CLIENT_ID; leaving it set has no effect and can be deleted.
# GOOGLE_CLIENT_ID=

# ------------------------------------------------- Firebase Auth (email/password)
# Real sign-up and sign-in. Without FIREBASE_PROJECT_ID + FIREBASE_API_KEY the
# email/password form stays disabled and says so; nothing is faked.
# Console → Project settings → General → "Your apps" → Web app → SDK setup and
# configuration. These three are PUBLIC identifiers, safe in the browser bundle.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Optional identifiers from the same Firebase panel. Analytics is NOT initialised by
# RideRise LK; these are stored for future features and shown to admins only.
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
# Demo/sandbox sign-in bridge for the bundled demo accounts. Production refuses it
# unless ALLOW_DEMO_SIGNIN=1. Set to 0 to disable it everywhere.
ALLOW_DEMO_SIGNIN=
# Trust X-Forwarded-For for rate limiting. Leave unset behind a local/private
# proxy (auto-detected); set 1 only when a trusted load balancer sets the header,
# 0 to always use the socket address.
TRUST_PROXY=

# --------------------------------------------------------- studio admin login
# Optional override for the bootstrap credential. Production REQUIRES these
# (or it prints a random one-time password to the log).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------- map tiles
# openstreetmap | maptiler | mapbox | thunderforest
MAP_PROVIDER=openstreetmap
# API key for the commercial providers (not needed for openstreetmap).
MAP_API_KEY=
# 1 = the server proxies tiles so the key never reaches the browser/APK.
MAP_PROXY_TILES=0

# --------------------------------------------------------------- voice (TURN)
# Preferred: a TURN REST credential (HMAC) — e.g. Twilio NTS or coturn's
# `use-auth-secret`. Comma-separate several URLs.
TURN_URLS=
TURN_SECRET=
# Alternative: a static username/credential.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------ push (FCM v1)
# Server half: path to the Firebase service-account JSON, or paste the JSON itself.
# Relative paths are resolved from the repository root (e.g. secrets/firebase-service-account.json,
# a git-ignored folder), absolute paths are used as-is. Keep the file mode 600 and rotate the key
# if it is ever exposed:  Firebase console -> Project settings -> Service accounts.
# Validate with `npm run check:fcm` (add `-- --online` to exchange a real OAuth token).
# Android half: android/app/google-services.json (git-ignored) + the Gradle project in
# android/ — see android/firebase/README.md. Both halves MUST use the same Firebase
# project, otherwise FCM rejects the device with 404 / UNREGISTERED.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------- optional
# Retention for private messages, in days (default 365). Applied when the database is
# first seeded, then editable from the studio console settings.
DM_RETENTION_DAYS=
